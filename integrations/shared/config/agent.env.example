# Copy to ~/.config/engram/agent.env and set only the values you need.
# Environment variables already set by the harness take precedence.

# Leave unset to use the current Git repository with .agents/memories,
# then fall back to ~/agent_memory when that directory exists.
# ENGRAM_LEDGER=~/agent_memory

# Leave unset to find engram on PATH.
# ENGRAM_BIN=/absolute/path/to/engram

# Optional mission source. Mission injection is skipped when unset.
# ENGRAM_MISSIONS_FILE=~/path/to/MISSIONS.md

# Optional display name used by the reader reminder. Defaults to "the user".
# ENGRAM_READER_NAME=the reader

# Claude Code only. Leave unset to derive the auto-memory directory from
# CLAUDE_PROJECT_DIR or the SessionStart cwd.
# ENGRAM_MEMORY_VIEW_DIR=~/.claude/projects/<project>/memory

# Optional shared checkpoint directory. Otherwise Claude uses its config
# directory and Codex uses CODEX_HOME.
# ENGRAM_CHECKPOINT_DIR=~/.local/share/engram/checkpoints

# Optional reader embedding index settings. This feature requires local Ollama.
# ENGRAM_OLLAMA_URL=http://localhost:11434/api/embed
# ENGRAM_OLLAMA_MODEL=nomic-embed-text
# ENGRAM_READER_INDEX=~/.cache/engram/reader-embed/index.json

# Optional generic estimator setting.
# ENGRAM_TOKEN_CHARS_PER_TOKEN=4
